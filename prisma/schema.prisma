// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  password             String
  name                 String?
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  savedItems SavedItem[]
}

model Route {
  id             String   @id @default(cuid())
  routeNumericId Int?     @unique // Original numeric ID from API (e.g., 18)
  name           String
  number         String
  origin         String
  destination    String
  totalStops     Int
  duration       Int
  createdAt      DateTime @default(now())

  stops Stop[]
  trips Trip[]

  @@index([routeNumericId])
}

model Stop {
  id             String @id @default(cuid())
  stopNumericId  Int?   // Original numeric ID from API (e.g., 1807)
  name           String
  latitude       Float
  longitude      Float
  sequence       Int
  routeId        String
  route          Route  @relation(fields: [routeId], references: [id])

  stopTimes StopTime[]

  @@index([routeId])
  @@index([stopNumericId])
}

model SavedItem {
  id       String   @id @default(cuid())
  userId   String
  nickname String?
  type     ItemType @default(JOURNEY)

  // For bus line bookmarks (type: ROUTE)
  routeId String?

  // For complex journeys (type: JOURNEY)
  itineraryData   Json?
  originLat       Float?
  originLng       Float?
  destinationLat Float?
  destinationLng Float?
  destinationName String?
  totalDistance   Int?
  totalDuration   Int?
  departureTime   DateTime? // When the journey should start

  lastViewed DateTime?
  createdAt  DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id])
  journeyStops JourneyStop[]

  @@index([userId])
  @@index([userId, type])
}

model JourneyStop {
  id            String    @id @default(cuid())
  savedItemId   String
  sequence      Int // Order of stops in the journey (0 = origin, 1 = first destination, etc.)

  // Location details
  name          String
  latitude      Float
  longitude     Float

  // Buffer time at this location (in minutes)
  bufferMinutes Int       @default(0)

  // Optional purpose/activity description
  purpose       String?

  // Calculated times (set when journey is planned)
  arrivalTime   DateTime?
  departureTime DateTime?

  createdAt     DateTime  @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId, sequence])
  @@index([savedItemId])
}

enum ItemType {
  ROUTE
  JOURNEY
}

model Service {
  id        String   @id @default(cuid())
  serviceId Int      @unique // GTFS service_id (e.g., 39, 43, 45)
  name      String?  // Optional friendly name
  createdAt DateTime @default(now())

  serviceDates ServiceDate[]
  trips        Trip[]

  @@index([serviceId])
}

model ServiceDate {
  id            String   @id @default(cuid())
  serviceId     Int
  date          DateTime @db.Date
  exceptionType Int // 1 = service added, 2 = service removed

  service Service @relation(fields: [serviceId], references: [serviceId])

  @@unique([serviceId, date])
  @@index([serviceId, date])
  @@index([date])
}

model Trip {
  id          String   @id @default(cuid())
  gtfsTripId  String   @unique // GTFS trip_id (e.g., "t1B3-b17D9-sl2B")
  routeId     String
  serviceId   Int
  directionId Int // 0 or 1
  headsign    String // Trip headsign/destination
  shapeId     String? // Optional shape for visualization
  createdAt   DateTime @default(now())

  route     Route      @relation(fields: [routeId], references: [id])
  service   Service    @relation(fields: [serviceId], references: [serviceId])
  stopTimes StopTime[]

  @@index([routeId])
  @@index([serviceId])
  @@index([gtfsTripId])
}

model StopTime {
  id            String  @id @default(cuid())
  tripId        String
  stopId        String
  arrivalTime   String // Stored as string due to 25:00:00+ format
  departureTime String // Stored as string due to 25:00:00+ format
  stopSequence  Int
  isTimepoint   Boolean @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop Stop @relation(fields: [stopId], references: [id])

  @@index([tripId, stopSequence])
  @@index([stopId])
  @@index([stopId, departureTime])
}
